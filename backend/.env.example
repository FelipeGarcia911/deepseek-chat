# Platform environment. All five settings are required; there are no implicit defaults.
NODE_ENV=development

# HTTP listener port: integer from 1 to 65535.
PORT=4000

# Comma-separated browser origins. No wildcards, credentials or URL paths.
CORS_ORIGINS=http://localhost:5173

# JSON storage path relative to the backend package, identical in dev and compiled runs.
CHAT_STORAGE_PATH=./data/chats.json

# PostgreSQL connection URL. Matches docker-compose.yml for local development.
DATABASE_URL=postgres://chat_app:chat_app@localhost:5432/chat_app
