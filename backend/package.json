{
  "name": "backend",
  "version": "1.0.0",
  "description": "ChatApp NodeJS + Express + TypeScript",
  "main": "index.js",
  "author": "Felipe Garcia",
  "license": "MIT",
  "scripts": {
    "dev": "nodemon --watch src --watch ../packages/shared/dist/cjs --ext ts,js,json src/server.ts --ignore \"src/logs/**\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@chat-app/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.5",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "private": true
}
