{
  "name": "chat-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm -r --parallel dev",
    "dev:backend": "pnpm build:packages && pnpm --filter \"backend...\" --parallel dev",
    "dev:frontend": "pnpm build:packages && pnpm --filter \"frontend...\" --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "pnpm --filter frontend lint",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "test": "pnpm build:packages && pnpm --filter backend test"
  }
}
