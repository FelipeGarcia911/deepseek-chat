{
  "name": "chat-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm -r --parallel dev",
    "dev:backend": "pnpm build:packages && pnpm --filter \"backend...\" --parallel dev",
    "dev:frontend": "pnpm build:packages && pnpm --filter \"frontend...\" --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "test": "pnpm build:packages && pnpm -r test",
    "test:coverage": "pnpm build:packages && pnpm -r --no-bail test:coverage",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:seed": "pnpm --filter backend db:seed",
    "db:reset": "pnpm --filter backend db:reset",
    "db:types": "pnpm --filter backend db:types"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "eslint": "9.19.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.18",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "typescript-eslint": "8.22.0"
  }
}
